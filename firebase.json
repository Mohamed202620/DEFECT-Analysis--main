{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "target": "dev",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**",
        "firestore.rules",
        "firestore.indexes.json",
        "server.js",
        "package.json",
        "patch.js",
        "src-firebase.js",
        "*.patch",
        "*.zip",
        "*.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "main",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "functions/**",
        "firestore.rules",
        "firestore.indexes.json",
        "server.js",
        "package.json",
        "patch.js",
        "src-firebase.js",
        "*.patch",
        "*.zip",
        "*.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
