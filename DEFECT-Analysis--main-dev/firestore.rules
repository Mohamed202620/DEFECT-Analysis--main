// ============================================================
// firestore.rules
// قواعد أمان Firestore - نسخة مبنية على Firebase Authentication
// الحقيقي (Email/Password، برقم موبايل محوَّل لإيميل داخلي - راجع
// config.js -> phoneToAuthEmail)
// ============================================================
//
// ⚠️ ملف موجود هنا كمرجع فقط - لازم تنسخه/تنشره فعلياً من
// Firebase Console (Firestore Database → Rules) أو عبر
// Firebase CLI (firebase deploy --only firestore:rules).
// إضافة الملف للمشروع لوحدها مبتفعّلش القواعد تلقائياً.
//
// ------------------------------------------------------------
// خطوة لازمة قبل النشر:
// ------------------------------------------------------------
// فعّلوا Firebase Authentication -> Sign-in method -> Email/Password
// من Firebase Console (خطوة مجانية، بدون Blaze). القواعد دي
// مبنية على افتراض إن كل عمليات تسجيل الدخول/التسجيل بقت تمر
// عبر Firebase Auth (راجع js/auth/login.js و js/services/usersApi.js).
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // بيانات ملف المستخدم الحالي (users/{uid}) - استدعاء get() له
    // تكلفة قراءة إضافية بسيطة، لكنه ضروري عشان نعرف دور/حالة
    // المستخدم فعلياً بدل الاعتماد على أي حاجة يبعتها العميل
    function myProfile() {
      let docSnapshot = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return docSnapshot == null ? null : docSnapshot.data;
    }

    function myRole() {
      let profile = myProfile();
      return profile == null ? "" : profile.role;
    }

    // إصلاح (بند A1 في تقرير المراجعة - حماية "آخر Admin" على مستوى
    // القاعدة، مش بس الواجهة): مستند المستخدم المستهدف حالياً "Admin
    // نشط" فعلاً (قبل التعديل/الحذف - resource.data)
    function targetIsActiveAdmin() {
      return resource.data.role == "admin" && resource.data.status == "active";
    }

    // هل المستند هيفضل "Admin نشط" بعد التعديل المطلوب (request.resource.data)
    function staysActiveAdmin() {
      return request.resource.data.role == "admin" && request.resource.data.status == "active";
    }

    // Security review (Auth/Roles): حقل reportedByUid (صاحب البلاغ) مينفعش
    // يتغيّر في أي تحديث - قواعد التذاكر بتعتمد عليه كمصدر للصلاحية في
    // خطوة "تأكيد الإغلاق" (resolved -> closed) ومكنش فيه أي قيد على
    // باقي الحقول: الفني المُسند كان يقدر في نفس تحديث "تم الإصلاح"
    // يغيّر reportedByUid لنفسه ثم يقفل البلاغ بنفسه (تخطي تأكيد المُبلّغ).
    function ticketReporterUnchanged() {
      return request.resource.data.get("reportedByUid", null) == resource.data.get("reportedByUid", null);
    }

    // حساب مفعّل (status == active) - شرط أساسي لأي عملية غير التسجيل
    function isActive() {
      let profile = myProfile();
      return isSignedIn() && profile != null && profile.status == "active";
    }

    // ------------------------------------------------------------
    // Security review (Auth/Roles): كل فحوصات الدور الإداري بقت
    // بتشترط إن الحساب نفسه "active" - كانت myRole() == "admin" /
    // isManagerRole() بتتحقق من حقل role بس، فأدمن/مدير موقوف
    // (status != active مع بقاء role) كان لسه بيعدّي أغلب القواعد
    // (بما فيها تعديل users نفسه وإعادة تفعيل حسابه بنفسه).
    // ------------------------------------------------------------
    function isAdmin() {
      return isActive() && myRole() == "admin";
    }

    // إصلاح (بند A2 في تقرير المراجعة): "Supervisor" بيتعامل كمدير
    // (نفس isManagerRole() في js/permissions.js - لازم يفضلوا متطابقين)
    function isManagerRole() {
      return isActive() && (myRole() == "manager" || myRole() == "supervisor");
    }

    // وصول كامل (admin / manager+supervisor / engineer) - كانت بعض
    // القواعد بتكتب ["admin","manager","engineer"] وبتسيب supervisor
    // بره بينما الواجهة (hasFullDataAccess) بتعامله كمدير
    // ----------------------------------------------------------
    // مساعدات دورة حياة التذكرة (إصلاحات H5/H6/M6)
    // ----------------------------------------------------------

    // المُسنَد إليه (إن وُجد) لازم يكون مستخدم نشط فعلاً - كان ممكن إسناد
    // بلاغ لمستخدم موقوف/مرفوض/محذوف ويفضل عالق (H6)
    function ticketAssigneeActive() {
      return request.resource.data.get("assignedToUid", null) == null
          || get(/databases/$(database)/documents/users/$(request.resource.data.assignedToUid)).data.status == "active";
    }

    // أمان (H5): isSelfResolved ما بقاش قيمة بيحددها العميل - لازم تساوي
    // (المُصلِح هو نفسه المُبلّغ الأصلي)، وresolvedByUid لازم = المستخدم الحالي
    function ticketResolveIdentityOk() {
      return request.resource.data.get("isSelfResolved", false) == (resource.data.get("reportedByUid", "") == request.auth.uid)
          && request.resource.data.get("resolvedByUid", "") == request.auth.uid;
    }

    // ليه أي حد (حتى المدير/الأدمن) ما يقدرش يقفل بلاغ "إصلاح ذاتي" هو
    // اللي أصلحه (تجاوز التحقق) - التأكيد لازم من طرف تاني
    function closerIsNotSelfResolver() {
      return resource.data.get("isSelfResolved", false) != true
          || resource.data.get("resolvedByUid", "") != request.auth.uid;
    }

    function isFullAccessRole() {
      return isAdmin() || isManagerRole() || (isActive() && myRole() == "engineer");
    }

    // ==========================================================
    // users
    // ==========================================================
    match /users/{userId} {

      // إنشاء حساب جديد (registerUserApi) - تسجيل عادي فقط:
      // status/role = pending دايماً (مايقدرش حد يسجل نفسه admin).
      //
      // Security review (Auth/Roles):
      //  - تم حذف فرع "الترحيل" (migratedFromId) بالكامل: كان بيسمح
      //    لأي شخص (التسجيل بـ Email/Password مفتوح لأي حد) يسجّل حساب
      //    Auth بإيميل مشتق من رقم هاتف مستخدم قديم لسه ماترحّلش، وبعدها
      //    يكتب مستند users بنفس role/status (admin مثلاً) = استيلاء على
      //    حساب. الترحيل بقى بيتم بالكامل على السيرفر (Cloud Function
      //    migrateLegacyAccount - functions/index.js) اللي بتتحقق من
      //    كلمة السر القديمة أولاً.
      //  - permissions لازم تكون فاضية و machineDepartment مايتكتبش عند
      //    التسجيل: قسم الماكينات (بيتحكم في صلاحيات machineErrors/
      //    pmRecords/machineChecklists) يحدده الأدمن فقط، لكن الإنشاء كان
      //    بيسمح للمتقدم يكتب أي قيمة فيه بنفسه ويفضل بعد الموافقة.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                         "name", "phone", "code", "job", "department", "shift",
                         "shiftColor", "leaveBalance", "role", "permissions",
                         "status", "createdAt"
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.matches("^[0-9]{8,15}$")
                    && request.resource.data.get("code", "") is string
                    && request.resource.data.get("code", "").size() <= 40
                    && request.resource.data.get("job", "").size() <= 60
                    && request.resource.data.get("department", "").size() <= 60
                    && request.resource.data.get("shift", "").size() <= 40
                    && request.resource.data.status == "pending"
                    && request.resource.data.role == "pending"
                    && request.resource.data.get("permissions", "") == ""
                    && request.resource.data.get("machineDepartment", null) == null;

      // قراءة مستند واحد: صاحبه (أياً كانت حالته - login.js محتاج يقرا
      // حالته وقت الدخول)، أو أدمن/مدير نشط
      allow get: if isSignedIn()
                 && (request.auth.uid == userId || isAdmin() || isManagerRole());

      // قراءة قائمة (list) - لمستخدم مفعّل (active) فقط:
      //  ١) أدمن/مدير: كل المستخدمين (صفحة users/requests)
      //  ٢) أي مستخدم مفعّل: المستخدمين اللي دورهم فني/مهندس/مدير/أدمن
      //     (لازم الاستعلام يتصفّى بـ where("role","in",[...]) - راجع
      //     fetchTechniciansApi / fetchManagersAndAdminsApi) لقوائم
      //     الإسناد والإشعارات.
      //
      // Security review (Auth/Roles): تم حذف استثناء "بدون تسجيل دخول
      // بحد أقصى نتيجة واحدة" (!isSignedIn() && request.query.limit <= 1):
      // كان بيسمح لأي زائر مجهول يقرا أي مستند users كامل (بأي where على
      // الهاتف) بما فيه password/passwordHash/salt للحسابات القديمة اللي
      // المستند بتاعها بيفضل موجود بعد الترحيل. كمان الفرع رقم ٢ كان بيشتغل
      // لأي حساب Auth حتى "pending" (والتسجيل مفتوح لأي حد) - دلوقتي
      // بيشترط isActive(). الترحيل من النظام القديم بقى عبر Cloud Function.
      allow list: if isActive()
                  && (isAdmin() || isManagerRole()
                      || resource.data.role in ["technician", "engineer", "admin", "manager", "supervisor"]);

      // تعديل: صاحب الحساب يعدّل بياناته الشخصية بس - ممنوع يغيّر
      // role/status/permissions/machineDepartment. تغيير الدور/الحالة/
      // الصلاحيات مقصور على أدمن "نشط" (isAdmin() بقت بتشترط active -
      // أدمن موقوف كان بيقدر يعيد تفعيل نفسه).
      //
      // حماية "آخر Admin" (بند A1): حتى الأدمن مينفعش يخرّج مستند "Admin
      // نشط" من هذه الحالة عبر updateDoc() مباشرة - ده لازم يمر عبر
      // Cloud Function (updateUserRoleAccount) اللي بتفحص فعلياً على
      // السيرفر.
      allow update: if isSignedIn()
                    && (
                      (
                        isAdmin()
                        && !(targetIsActiveAdmin() && !staysActiveAdmin())
                      )
                      || (
                        request.auth.uid == userId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                             "phone", "approvedBy", "approvedAt", "approvedByUid",
                             "migratedFromId", "migratedAt", "password", "passwordHash", "salt"
                           ])
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.permissions == resource.data.permissions
                        && request.resource.data.get("machineDepartment", null) == resource.data.get("machineDepartment", null)
                      )
                    );

      // حذف: ممنوع من العميل تماماً - الحذف الفعلي عبر Cloud Function
      // (deleteUserAccount) اللي بتحذف حساب Auth + المستند معاً.
      allow delete: if false;
    }

    // ==========================================================
    // tickets - دورة حياة التذكرة (بدون رجوع للخلف إلا استثناء واحد)
    // pending(جديد) -> assigned(تم الإسناد) -> in_progress(قيد التنفيذ)
    //   -> resolved(بانتظار تأكيد المُبلغ) -> closed(مغلق) [نهائية]
    //                              resolved -> in_progress (رفض المُبلغ مع سبب)
    // ==========================================================
    match /tickets/{ticketId} {

      allow read: if isActive();

      // STEP 1 - أي مستخدم مفعّل يقدر يفتح تذكرة جديدة (pending أو resolved عند الإصلاح الذاتي)
      allow create: if isActive()
                    && request.resource.data.status in ["pending", "resolved"]
                    && request.resource.data.reportedByUid == request.auth.uid
                    && request.resource.data.get("createdAtServer", null) == request.time
                    && request.resource.data.get("description", "").size() <= 5000
                    // الإصلاح الذاتي عند الإنشاء: المُبلّغ هو المُصلِح بالضرورة (H5)
                    && request.resource.data.get("isSelfResolved", false) == (request.resource.data.status == "resolved")
                    && (request.resource.data.status != "resolved"
                        || request.resource.data.get("resolvedByUid", "") == request.auth.uid)
                    && (request.resource.data.status != "pending"
                        || request.resource.data.get("assignedToUid", null) == null);

      // STEP 2 - pending -> assigned: مدير الصيانة أو أدمن فقط
      allow update: if isActive() && (isAdmin() || isManagerRole())
                    && resource.data.status == "pending"
                    && request.resource.data.status == "assigned"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ["status", "type", "assignedTo", "assignedToUid", "updatedAt", "updatedBy"])
                    && ticketAssigneeActive()
                    && ticketReporterUnchanged();

      // STEP 2b - (assigned | in_progress | reopened) -> pending: اعتذار الفني المُسند إليه وإعادة العطل لقائمة الانتظار
      // (reopened أُضيفت: الواجهة - getTicketActions في permissions.js -
      // بتعرض زر "اعتذار" للفني على تذكرة reopened لكن القاعدة كانت بترفضه)
      allow update: if isActive()
                    && resource.data.status in ["assigned", "in_progress", "reopened"]
                    && request.resource.data.status == "pending"
                    && (isAdmin() || isManagerRole() || resource.data.assignedToUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ["status", "assignedTo", "assignedToUid", "declineReason", "declinedBy", "declinedAt", "updatedAt", "updatedBy"])
                    && ticketReporterUnchanged();

      // STEP 3 - assigned -> in_progress: الفني المُسند له التذكرة
      // بالتحديد (assignedToUid) بيبدأ التنفيذ فعلياً، أو أدمن
      allow update: if isActive()
                    && resource.data.status == "assigned"
                    && request.resource.data.status == "in_progress"
                    && (isAdmin() || resource.data.assignedToUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
                    && ticketReporterUnchanged();

      // STEP 4 - (pending | in_progress | assigned | reopened) -> resolved: الفني المُسند له أو صاحب البلاغ عند الإصلاح الذاتي
      allow update: if isActive()
                    && resource.data.status in ["pending", "in_progress", "assigned", "reopened"]
                    && request.resource.data.status == "resolved"
                    && (isAdmin() || resource.data.assignedToUid == request.auth.uid || resource.data.reportedByUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ["status", "mechanicNotes", "afterImages", "resolvedAt", "resolvedAtServer",
                          "resolvedBy", "resolvedByUid", "isSelfResolved", "updatedAt", "updatedBy"])
                    && request.resource.data.get("resolvedAtServer", null) == request.time
                    && ticketResolveIdentityOk()
                    && ticketReporterUnchanged();

      // STEP 5 - resolved -> closed (تأكيد) | in_progress (رفض مع
      // سبب - الاستثناء الوحيد المسموح للرجوع للخلف): صاحب البلاغ
      // الأصلي (reportedByUid) أو أدمن فقط
      // إصلاح (Workflow): (1) المدير/المشرف كانوا مستبعدين رغم إن الواجهة بتعرض لهم
      // "إغلاق جماعي" فكان بيفشل، وأي تذكرة resolved بيغادر صاحبها بتعلق للأبد.
      // (2) الإصلاح الذاتي (المُبلّغ هو من أصلح - isSelfResolved) لا يجوز أن يغلقه
      // المُبلّغ نفسه؛ التأكيد يكون من مدير/مشرف/أدمن. الرفض (in_progress) يفضل متاح له.
      allow update: if isActive()
                    && resource.data.status == "resolved"
                    && request.resource.data.status in ["closed", "in_progress"]
                    && (isAdmin() || isManagerRole()
                        || (resource.data.reportedByUid == request.auth.uid
                            && (request.resource.data.status != "closed"
                                || resource.data.get("isSelfResolved", false) != true)))
                    && (request.resource.data.status != "closed" || closerIsNotSelfResolver())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
                    && ticketReporterUnchanged();

      // STEP 5b - resolved -> reopened (رفض المُبلّغ من الواجهة -
      // reopenTicketApi): صاحب البلاغ الأصلي أو أدمن
      allow update: if isActive()
                    && resource.data.status == "resolved"
                    && request.resource.data.status == "reopened"
                    && (isAdmin() || isManagerRole() || resource.data.reportedByUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "operatorFeedback", "updatedAt", "updatedBy"])
                    && ticketReporterUnchanged();

      // STEP 6 - إعادة الإسناد (reassignTicketApi): مدير/أدمن فقط، على
      // تذكرة مفتوحة (assigned | in_progress | reopened) وترجع assigned
      allow update: if isActive() && (isAdmin() || isManagerRole())
                    && resource.data.status in ["assigned", "in_progress", "reopened"]
                    && request.resource.data.status == "assigned"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ["status", "assignedTo", "assignedToUid", "updatedAt", "updatedBy"])
                    && ticketAssigneeActive()
                    && ticketReporterUnchanged();

      // STEP 7 - إضافة ملاحظة تسليم وردية (appendShiftNoteToTicketApi من
      // issueView.js): تحديث بدون تغيير الحالة - مفيش أي قاعدة أعلاه كانت
      // بتسمح بتحديث "نفس الحالة"، فالميزة كانت بترجع permission-denied
      // لأي فني (تشتغل بالصدفة بس لمدير/أدمن على تذكرة assigned عبر STEP 6).
      // مقيّدة بـ: تذكرة مفتوحة، مفاتيح shiftUpdates/lastShiftUpdate/
      // updatedAt فقط، إضافة عنصر واحد بالظبط مع الحفاظ على العناصر
      // القديمة كما هي، وreporterUid للعنصر الجديد = المستخدم نفسه.
      allow update: if isActive()
                    && resource.data.status in ["pending", "assigned", "in_progress", "reopened", "resolved"]
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["shiftUpdates", "lastShiftUpdate", "updatedAt"])
                    && request.resource.data.shiftUpdates is list
                    && request.resource.data.shiftUpdates.size() == resource.data.get("shiftUpdates", []).size() + 1
                    && request.resource.data.shiftUpdates[0:resource.data.get("shiftUpdates", []).size()] == resource.data.get("shiftUpdates", [])
                    && request.resource.data.shiftUpdates[request.resource.data.shiftUpdates.size() - 1].reporterUid == request.auth.uid
                    && request.resource.data.shiftUpdates[request.resource.data.shiftUpdates.size() - 1].get("note", "").size() <= 2000;

      // سجل التغييرات (Logs) - سجل تلقائي فقط، مفيش تعديل أو حذف
      // (append-only) - أي مستخدم مفعّل يقدر يقرأ سجل تذكرة يقدر
      // يقرأها هو أصلاً (نفس شرط قراءة التذكرة)
      match /logs/{logId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ==========================================================
    // ملاحظة (إصلاح أمني - بند حرج): كان هنا بلوك قديم مكرر لنفس
    // المسار match /notifications/{notificationId} يستخدم حقل
    // "userId" (غير مستخدم فعلياً في أي مكان بالكود الحالي - راجع
    // ticketsApi.js اللي بيستخدم "forUid" فقط) مع allow create: if
    // isActive() بدون أي تحقق على محتوى المستند. بما إن Firestore
    // بيجمع كل الـ match blocks المطابقة لنفس المسار بمنطق OR، فكان
    // البلوك القديم ده فعلياً بيُلغي كل التشديد المكتوب في البلوك
    // الصحيح تحت (النتيجة الفعلية = أي مستخدم نشط يقدر ينشئ إشعار
    // بأي محتوى لأي مستخدم، رغم إن نية الكود الظاهرة في تعليقات
    // البلوك الثاني كانت منع ده بالضبط). تم حذف البلوك القديم بالكامل
    // - البلوك الوحيد المعتمد الآن هو الأحدث (forUid) الموجود تحت في
    // قسم "notifications" الثاني.
    // ==========================================================



    // ==========================================================
    // suggestions - مقترحات الكايزن (Kaizen) - دورة حياة صارمة
    // مطابقة تمامًا لمنطق services/suggestionsApi.js:
    //
    // new(جديد) -> under_review(قيد مراجعة) [admin]
    //           -> rejected(مرفوض) [admin، سبب إجباري]
    // under_review -> in_progress(قيد تنفيذ) [admin، موافقة+إسناد لفني]
    //              -> rejected(مرفوض) [admin، مسموح حتى لو بالفعل قيد
    //                 المراجعة، سبب إجباري]
    //              -> revision_requested(يحتاج تعديل) [admin، ملاحظات إجبارية]
    // revision_requested -> under_review [admin مباشرة، أو صاحب
    //                        المقترح نفسه (submittedByUid) بعد تعديل
    //                        العنوان/المشكلة/الحل - "إعادة إرسال للمراجعة"]
    // in_progress -> implemented(تم التنفيذ) [الفني المسؤول المُسند
    //                إليه (assignedToUid)، أو admin]
    // rejected / implemented = حالتان نهائيتان - ممنوع أي تحديث بعدهما
    //
    // الدور الإداري المعتمد هنا هو "admin" فقط - لا يوجد أي دور PM/
    // manager لهذا الـWorkflow (خلافاً لـ tickets اللي بيسمح لـ manager
    // أيضاً - ده مقصود ومختلف عمداً بناءً على متطلبات مقترحات الكايزن)
    // ==========================================================
    match /suggestions/{suggestionId} {

      allow read: if isActive();

      // إنشاء مقترح جديد - أي مستخدم مفعّل، لازم يبدأ status == "new"
      // دايماً (زي ما بيفرضه saveSuggestionApi أصلاً من جهة العميل)
      allow create: if isActive()
                    && request.resource.data.status == "new";

      // STEP 1a - new -> under_review: أدمن فقط
      allow update: if isActive() && isAdmin()
                    && resource.data.status == "new"
                    && request.resource.data.status == "under_review";

      // STEP 1b / 2b - (new | under_review) -> rejected: أدمن فقط،
      // سبب الرفض إجباري وغير فارغ (rejectionReason) - مسموح صراحة
      // حتى لو كان المقترح بالفعل "قيد المراجعة"
      allow update: if isActive() && isAdmin()
                    && resource.data.status in ["new", "under_review"]
                    && request.resource.data.status == "rejected"
                    && request.resource.data.rejectionReason is string
                    && request.resource.data.rejectionReason.size() > 0;

      // STEP 2a - under_review -> in_progress: أدمن فقط، وموافقة مع
      // إسناد لفني مسؤول (assignedTo/assignedToUid إجباريين ومش فاضيين)
      allow update: if isActive() && isAdmin()
                    && resource.data.status == "under_review"
                    && request.resource.data.status == "in_progress"
                    && request.resource.data.assignedTo is string
                    && request.resource.data.assignedTo.size() > 0
                    && request.resource.data.assignedToUid is string
                    && request.resource.data.assignedToUid.size() > 0;

      // STEP 2c - under_review -> revision_requested: أدمن فقط،
      // ملاحظات طلب التعديل إجبارية وغير فارغة (revisionNotes)
      allow update: if isActive() && isAdmin()
                    && resource.data.status == "under_review"
                    && request.resource.data.status == "revision_requested"
                    && request.resource.data.revisionNotes is string
                    && request.resource.data.revisionNotes.size() > 0;

      // STEP 3a - revision_requested -> under_review (رجوع للمراجعة
      // بعد التعديل من الأدمن مباشرة بدون تعديل المحتوى): أدمن فقط
      allow update: if isActive() && isAdmin()
                    && resource.data.status == "revision_requested"
                    && request.resource.data.status == "under_review";

      // STEP 3b - revision_requested -> under_review: صاحب المقترح
      // نفسه (submittedByUid) يعدّل المقترح (عنوان/مشكلة/حل) بعد
      // ملاحظات الأدمن، ثم يعيد إرساله للمراجعة بنفسه
      //
      // إصلاح: بعض المقترحات القديمة (قبل إضافة تتبّع submittedByUid،
      // أو لو اتسجّلت والحقل فاضي لأي سبب) مفيهاش الحقل ده أصلاً -
      // فكان صاحبها الحقيقي (اللي بيظهر اسمه فعلاً على الكارت) عمره
      // ما هيقدر يعدّل ويعيد الإرسال لأن resource.data.submittedByUid
      // == request.auth.uid مستحيل تتحقق أصلاً (undefined != uid).
      // الشرط الاحتياطي التاني بيسمح فقط لو الحقل ده مش موجود على
      // السجل، ولازم كمان اسم المستخدم الحالي (users/{uid}.name)
      // يطابق تمامًا اسم صاحب المقترح المسجَّل وقت الإرسال - وبمجرد
      // ما يحصل resubmit مرة، الحقل submittedByUid بيتثبّت على القيمة
      // الصحيحة (راجع resubmitSuggestionApi) فمايتكررش الاحتياج للمسار
      // ده تاني على نفس السجل
      allow update: if isActive()
                    && resource.data.status == "revision_requested"
                    && (
                         resource.data.submittedByUid == request.auth.uid
                         ||
                         (
                           !("submittedByUid" in resource.data)
                           && resource.data.name == myProfile().name
                         )
                       )
                    && request.resource.data.status == "under_review"
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.problem is string
                    && request.resource.data.problem.size() > 0
                    && request.resource.data.solution is string
                    && request.resource.data.solution.size() > 0;

      // STEP 4 - in_progress -> implemented: الفني المسؤول المُسند
      // إليه بالتحديد (assignedToUid) فقط، أو أدمن - حالة نهائية بعدها
      allow update: if isActive()
                    && resource.data.status == "in_progress"
                    && request.resource.data.status == "implemented"
                    && (isAdmin() || resource.data.assignedToUid == request.auth.uid);

      allow delete: if false;

      // سجل تغييرات المقترح (Logs) - append-only، نفس فكرة
      // tickets/{ticketId}/logs بالضبط
      match /logs/{logId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ==========================================================
    // officialHolidays - الإجازات الرسمية (تُستخدم في كارت حضور
    // الوردية لاحتساب أيام العمل المصادفة لإجازة رسمية كإضافي
    // بالكامل - راجع attendanceCard.js / holidaysApi.js). القراءة
    // لأي مستخدم مفعّل (محتاجينها في الكارت)، لكن الإضافة/الحذف
    // مقصورة على الأدمن فقط (صلاحية "settings" - راجع pageRenderer.js)
    // ==========================================================
    match /officialHolidays/{holidayId} {
      allow read: if isActive();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // ==========================================================
    // settings/attendancePattern و settings/payrollRules - بيانات
    // Global لـ "حاسبة الحضور والمرتبات" (راجع attendanceCard.js /
    // attendanceSettingsApi.js): جدول Pattern الورديات (GREEN/BLUE/RED)
    // ومعاملات حساب الإضافي. القراءة لأي مستخدم مفعّل (محتاجينها في
    // الكارت لكل الموظفين)، لكن الكتابة مقصورة على الأدمن فقط.
    // ⚠️ ملحوظة: مفيش أي بيانات مالية شخصية (مرتب/تأمينات/PIN) هنا
    // إطلاقاً - دي محلية 100% على جهاز المستخدم (localStorage) ولا
    // تُرسل لـ Firestore نهائياً، فمفيش داعي لأي قاعدة أمان ليها.
    // ==========================================================
    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ==========================================================
    // machineTypes - قائمة أنواع الماكينات المستخدمة في كل فورمات
    // التطبيق (تسجيل عطل/كايزن/فاحص الأعطال/بحث الصيانة - راجع
    // machines.js/machinesApi.js/MachinesView.js). القراءة لأي
    // مستخدم مفعّل (محتاجينها في كل الفورمات دي)، لكن الإضافة/
    // التعديل/الحذف مقصورة على الأدمن فقط (صلاحية "machines")، بنفس
    // أسلوب officialHolidays فوق - بدون هذا الـ match الصريح كانت
    // هتقع تحت match /{document=**} تحت وأي مستخدم مفعّل هيقدر
    // يعدّل/يحذف منها مباشرة عبر Firestore SDK بغض النظر عن فحص
    // hasPermission("machines") في الواجهة (اللي بيتحقق في المتصفح
    // بس ومش كافي وحده كحماية فعلية)
    // ==========================================================
    match /machineTypes/{machineTypeId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    // ==========================================================
    // notifications - إشعارات داخل التطبيق (راجع ticketsApi.js ->
    // createNotification / fetchMyNotificationsApi / markNotificationReadApi)
    // كانت واقعة تحت match /{document=**} العام تحت (allow read, write:
    // if isActive()) - يعني أي مستخدم مفعّل يقدر تقنياً يعمل
    // getDocs(collection(db,"notifications")) بدون where ويقرا
    // إشعارات كل المستخدمين، رغم إن الواجهة نفسها دايماً بتستعلم
    // بـ where("forUid","==", uid) فقط. الـ match الصريح ده بيقيّد
    // القراءة فعلياً على مستوى القاعدة لصاحب الإشعار (forUid) أو
    // الأدمن/المدير، ويقيّد التعديل على تحديث حقل read بس من صاحبه.
    // ==========================================================
    match /notifications/{notificationId} {

      // قراءة (get/list): صاحب الإشعار (forUid) فقط، أو أدمن/مدير
      // للمتابعة العامة عند الحاجة
      allow read: if isActive()
                  && (resource.data.forUid == request.auth.uid
                      || isAdmin() || isManagerRole());

      // إنشاء: أي مستخدم مفعّل يقدر يبعت إشعار لمستخدم تاني (زي
      // إسناد تذكرة/مقترح لفني - createNotification بتتنفذ من جهاز
      // المُسنِد مش من سيرفر خلفي)، لازم forUid ومحتوى الإشعار
      // الأساسي موجودين
      // أمان (C1): كان بيقبل أي type/message/حقول - ده كان قناة Stored XSS.
      // دلوقتي: حقول محددة فقط، type من قائمة معروفة، message بطول محدود،
      // وcreatedByUid (لو اتبعت) لازم يكون هو المرسل الفعلي.
      allow create: if isActive()
                    && request.resource.data.keys().hasOnly(
                         ["forUid", "type", "message", "ticketId", "suggestionId", "read", "createdAt", "createdByUid"])
                    && request.resource.data.forUid is string
                    && request.resource.data.forUid.size() > 0
                    && request.resource.data.forUid.size() <= 128
                    && request.resource.data.type in [
                         "assigned", "closed", "declined", "implemented", "in_progress",
                         "new_suggestion", "new_ticket", "rejected", "resolved", "resubmitted",
                         "revision_requested", "under_review", "escalated", "released", "pattern", "shift_update"
                       ]
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.get("createdByUid", request.auth.uid) == request.auth.uid
                    && request.resource.data.read == false;

      // تعديل: صاحب الإشعار بس، وبس حقل read (markNotificationReadApi/
      // markAllNotificationsAsRead) - ممنوع أي تعديل تاني على المحتوى
      allow update: if isActive()
                    && resource.data.forUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      allow delete: if false;
    }

    // ==========================================================
    // machineErrors / machineErrorLogs / pmRecords - إصلاح (بند حرج -
    // حماية سيرفرية لقيود القسم Backend/Frontend): كانت المجموعات دي
    // الثلاثة واقعة بالكامل تحت match /{document=**} العام تحت (أي
    // مستخدم مفعّل يقدر يقرأ/يكتب/يعدّل/يحذف أي مستند فيها بلا أي
    // قيد)، رغم إن الواجهة (machines.js/errorScanner.js) دلوقتي
    // بتفلتر الماكينات المعروضة حسب قسم المستخدم - الفلترة دي وحدها
    // مش كافية لأنها قابلة للتجاوز الكامل من أي مستخدم عبر DevTools/
    // استدعاء الـ SDK مباشرة.
    //
    // القراءة تُركت مفتوحة لأي مستخدم مفعّل (نفس مبدأ الشفافية
    // المُطبَّق أصلاً على /tickets فوق - كل الأقسام تقدر تشوف حالة
    // الأعطال/الصيانة في المصنع ككل)، لكن الإنشاء بقى مقيّد: حقل
    // "department" (بيتحفظ تلقائياً مع كل مستند جديد - راجع
    // getDepartmentForMachineValue في machines.js المُستخدمة في
    // machineErrorsApi.js/pmApi.js) لازم يكون قيمة صحيحة (backend/
    // frontend) ويطابق قسم المستخدم المُبلِّغ نفسه، إلا لو كان
    // صاحب صلاحية وصول كامل (admin/manager/engineer) وقتها يقدر
    // يسجّل بالنيابة عن أي قسم.
    //
    // ⚠️ ملحوظة أمانة: التحقق هنا بيتأكد إن قيمة "department" المُرسلة
    // تطابق قسم المستخدم نفسه، مش إنها فعلاً القسم الصحيح لاسم
    // الماكينة المكتوب - التحقق الكامل (ربط اسم الماكينة بقسمها عبر
    // get() على machineTypes) مش ممكن حالياً لأن مستندات machineTypes
    // بتُنشأ بـ addDoc (معرّف تلقائي)، مش بمعرّف = مفتاح الماكينة نفسه،
    // فمفيش مسار مباشر نقدر نعمله get() بيه من جوه الـ Rule. الضمانة
    // الفعلية لصحة الربط اسم/قسم فعلاً موجودة على مستوى الواجهة
    // (Dropdown مفلتر مسبقاً) - القاعدة هنا بتمنع أي محاولة تلاعب
    // مباشرة (كتابة بقسم مش بتاعك) حتى لو الواجهة اتلاعب بيها.
    //
    // التعديل (update) والحذف (delete) - كانا برضه مفتوحين لأي
    // مستخدم مفعّل تحت الـ catch-all (حتى الإجراءات الإدارية زي
    // "اعتماد عطل" - verifyMachineErrorApi - ما كانش ليها أي حماية
    // سيرفرية رغم إنها مقيّدة في الواجهة فقط بصلاحية "machines").
    // بقت مقصورة على أدمن/مدير.
    // ==========================================================
    match /machineErrors/{errorId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.department in ["backend", "frontend"]
                    && (isFullAccessRole()
                        || request.resource.data.department == myProfile().machineDepartment);
      allow update: if isActive() && (isAdmin() || isManagerRole());
      allow delete: if isAdmin();
    }

    match /machineErrorLogs/{logId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.department in ["backend", "frontend"]
                    && (isFullAccessRole()
                        || request.resource.data.department == myProfile().machineDepartment);
      // سجل تكرار تلقائي فقط (Append-Only) - بلا تعديل أو حذف، بنفس
      // مبدأ /tickets/{ticketId}/logs فوق
      allow update, delete: if false;
    }

    match /pmRecords/{pmId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.department in ["backend", "frontend"]
                    && (isFullAccessRole()
                        || request.resource.data.department == myProfile().machineDepartment);
      allow update, delete: if isAdmin();
    }

    // ==========================================================
    // machineChecklists - سجلات ميزة "QR Machine + Daily AM +
    // 5S" الجديدة (Daily AM Checklist اليومي + تقييم 5S - راجع
    // services/checklistApi.js). نفس مبدأ حماية القسم المطبَّق
    // بالظبط على machineErrors/pmRecords فوق: القراءة مفتوحة لأي
    // مستخدم مفعّل (نفس مبدأ الشفافية)، لكن الإنشاء مقيّد بحقل
    // "department" يطابق قسم المستخدم المُبلِّغ نفسه، إلا لو كان
    // صاحب صلاحية وصول كامل (admin/manager/engineer). التعديل/الحذف
    // مقصوران على الأدمن فقط (سجلات Append-Only بعد الإنشاء).
    // ==========================================================
    match /machineChecklists/{checklistId} {
      allow read: if isActive();
      allow create: if isActive()
                    && request.resource.data.type in ["am", "5s"]
                    && request.resource.data.department in ["backend", "frontend"]
                    && (isFullAccessRole()
                        || request.resource.data.department == myProfile().machineDepartment);
      allow update, delete: if isAdmin();
    }

    // ==========================================================
    // machineAmTemplates - تخصيص بنود فحص Daily AM لكل ماكينة على
    // حدة (تُدار من زر "✏️ Edit Checklist" في ملف الماكينة -
    // MachineProfileView.js/window.openManageAmModal، ومعروضة فقط
    // للأدمن هناك - راجع adminRights = isAdminRole()). القراءة
    // مفتوحة لأي مستخدم مفعّل (كل مستخدم محتاج يقرأ البنود
    // المخصصة وقت تعبئة الفحص اليومي - DailyAMView.js).
    //
    // إصلاح (بند أمني مؤكد بالاختبار العملي - Test 6): هذه
    // المجموعة لم يكن لها match block مخصص، فكانت بتقع تحت قاعدة
    // الحماية العامة في آخر الملف (allow read, write: if isActive())
    // - يعني أي مستخدم مفعّل (فني عادي مثلاً) كان يقدر يكتب/يتلاعب
    // مباشرة ببنود فحص أي ماكينة عبر Firestore مباشرة (تجاوزاً
    // للواجهة)، رغم إن التعديل مقصود يكون للأدمن فقط. نفس نمط
    // الحماية المستخدم بالظبط في machineTypes (create/update/delete
    // admin-only، read مفتوح للجميع النشطين).
    // ==========================================================
    // ==========================================================
    // machineAmTemplates & fiveSTemplates - ITEMS-EDITOR
    // تخصيص وإدارة بنود فحص Daily AM وفحص 5S لكل ماكينة
    // القراءة متاحة لكل مستخدم نشط، والإنشاء/التعديل/الحذف مقصوران
    // على الأدمن والمدير (isManagerRole).
    // ==========================================================
    match /machineAmTemplates/{machineId} {
      allow read: if isActive();
      allow create, update, delete: if isActive() && (isAdmin() || isManagerRole());
    }

    match /fiveSTemplates/{templateId} {
      allow read: if isActive();
      allow create, update, delete: if isActive() && (isAdmin() || isManagerRole());
    }

    // ==========================================================
    // daily_tips - بنك المعلومات وإدارة معلومة على الماشي
    // ==========================================================
    match /daily_tips/{tipId} {
      allow read: if isActive();
      allow create, update, delete: if isActive() && (isAdmin() || isManagerRole());
    }

    // ==========================================================
    // Security (Test 15) - تم حذف القاعدة العامة الأخيرة:
    //     match /{document=**} { allow read, write: if isActive(); }
    // Firestore بيجمع كل match/allow المطابقة لنفس المسار بمنطق OR،
    // والقاعدة دي بتطابق كل المسارات (بما فيها users وtickets
    // وnotifications وsettings...) - يعني كانت بتلغي فعلياً كل
    // القيود المكتوبة في الأعلى وبتسمح لأي مستخدم مفعّل (حتى فني
    // عادي) يكتب/يحذف أي مستند ويرقّي نفسه Admin. أي مجموعة بدون
    // match صريح (زي defects - غير مستخدمة في الواجهة) بقت مرفوضة.
    // ==========================================================
  }
}
