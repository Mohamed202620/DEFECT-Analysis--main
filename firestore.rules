// ============================================================
// firestore.rules
// ⚠️ مرجع فقط - لازم يُنشر فعلياً من Firebase Console
// (Firestore Database → Rules) أو firebase deploy --only firestore:rules
// ============================================================
//
// يفترض إن Firebase Authentication (Email/Password) مفعّل بالفعل
// وإن كل تسجيل دخول/تسجيل حساب بيمر عبره (راجع js/auth/login.js
// و js/services/usersApi.js من التحديث السابق).
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : "";
    }

    function isActive() {
      return isSignedIn() && myProfile().status == "active";
    }

    function isAdminOrManager() {
      return myRole() in ["admin", "manager"];
    }

    // ==========================================================
    // users
    // ==========================================================
    match /users/{userId} {

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == "pending"
                    && request.resource.data.role == "pending"
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && !request.resource.data.keys().hasAny(["password", "passwordHash", "salt"]);

      allow get: if isSignedIn()
                 && (request.auth.uid == userId || isAdminOrManager());

      // list بدون فلتر role غير مسموحة إلا لأدمن/مدير (شرط
      // مستقل عن محتوى كل مستند -> آمن لكل الـ collection دفعة
      // واحدة). أي مستخدم مفعّل تاني لازم يقيّد استعلامه بـ
      // where("role","in",[...]) زي fetchTechniciansApi تحديداً.
      allow list: if isSignedIn()
                  && (isAdminOrManager()
                      || resource.data.role in ["technician", "engineer"]);

      allow update: if isSignedIn()
                    && (request.auth.uid == userId || myRole() == "admin");

      allow delete: if myRole() == "admin";
    }

    // ==========================================================
    // tickets - دورة حياة التذكرة:
    //   pending -> assigned -> in_progress -> awaiting_confirmation -> closed
    //   الاستثناء الوحيد للرجوع: awaiting_confirmation -> in_progress
    // ==========================================================
    match /tickets/{ticketId} {

      // قراءة مستند/تذكرة واحدة (get): أدمن/مدير، أو الفني المُسند
      // له، أو صاحب البلاغ - راجع ملحوظة list تحت
      allow get: if isActive() && (
                   isAdminOrManager()
                   || resource.data.assignedToUid == request.auth.uid
                   || resource.data.reportedByUid == request.auth.uid
                 );

      // قراءة قائمة (list): لازم شرط مستقل عن محتوى كل مستند
      // (أدمن/مدير) أو مطابق لفلتر فعلي في الاستعلام نفسه
      // (assignedToUid أو reportedByUid) - وده بالظبط اللي بتعمله
      // fetchTicketsForTechnicianApi / fetchAwaitingConfirmationTicketsApi
      // في ticketsApi.js (لازم الاستعلامات تفضل متوافقة مع الشرط ده)
      allow list: if isActive() && (
                    isAdminOrManager()
                    || resource.data.assignedToUid == request.auth.uid
                    || resource.data.reportedByUid == request.auth.uid
                  );

      // STEP 1 - أي مستخدم مفعّل يقدر يفتح تذكرة جديدة (pending)
      // منسوبة له فعلياً
      allow create: if isActive()
                    && request.resource.data.status == "pending"
                    && request.resource.data.reportedByUid == request.auth.uid;

      // STEP 2 - pending -> assigned: مدير الصيانة أو أدمن فقط
      allow update: if isActive() && isAdminOrManager()
                    && resource.data.status == "pending"
                    && request.resource.data.status == "assigned";

      // STEP 3A - assigned -> in_progress: الفني المُسند له فقط
      allow update: if isActive()
                    && resource.data.status == "assigned"
                    && request.resource.data.status == "in_progress"
                    && (myRole() == "admin" || resource.data.assignedToUid == request.auth.uid);

      // STEP 3B - in_progress -> awaiting_confirmation: نفس الفني
      allow update: if isActive()
                    && resource.data.status == "in_progress"
                    && request.resource.data.status == "awaiting_confirmation"
                    && (myRole() == "admin" || resource.data.assignedToUid == request.auth.uid);

      // STEP 4 - awaiting_confirmation -> closed | in_progress (رفض):
      // صاحب البلاغ الأصلي فقط - الاستثناء الوحيد للرجوع للخلف
      allow update: if isActive()
                    && resource.data.status == "awaiting_confirmation"
                    && request.resource.data.status in ["closed", "in_progress"]
                    && (myRole() == "admin" || resource.data.reportedByUid == request.auth.uid);

      // ------------------------------------------------------
      // logs - سجل عمليات غير قابل للتعديل أو الحذف مطلقاً
      // (لا توجد قاعدة allow update ولا allow delete هنا عمداً
      // = ممنوعتين تلقائياً لأي مستخدم بما فيهم الأدمن)
      // ------------------------------------------------------
      match /logs/{logId} {

        allow get: if isActive() && (
                     isAdminOrManager()
                     || get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedToUid == request.auth.uid
                     || get(/databases/$(database)/documents/tickets/$(ticketId)).data.reportedByUid == request.auth.uid
                   );

        allow list: if isActive() && (
                      isAdminOrManager()
                      || get(/databases/$(database)/documents/tickets/$(ticketId)).data.assignedToUid == request.auth.uid
                      || get(/databases/$(database)/documents/tickets/$(ticketId)).data.reportedByUid == request.auth.uid
                    );

        allow create: if isActive() && request.resource.data.byUid == request.auth.uid;
      }
    }

    // ==========================================================
    // notifications
    // ==========================================================
    match /notifications/{notificationId} {

      // القراءة والتعديل (تعليم كمقروء فقط) لصاحب الإشعار حصرياً
      allow get: if isActive() && resource.data.userId == request.auth.uid;

      allow list: if isActive() && resource.data.userId == request.auth.uid;

      // الإنشاء: أي مستخدم مفعّل (النظام بيبعت إشعارات لمستخدمين
      // تانيين تلقائياً من ticketsApi.js عند كل انتقال حالة - مفيش
      // Cloud Functions هنا، فالإنشاء بيتم من جهاز المستخدم اللي
      // عمل الإجراء، لصالح المستخدم التاني)
      allow create: if isActive() && request.resource.data.userId is string;

      // تعديل: صاحب الإشعار فقط، وبس حقل read (منع تلاعب بمحتوى
      // إشعار موجّه له)
      allow update: if isActive()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      allow delete: if false;
    }

    // ==========================================================
    // باقي المجموعات (machineErrors, pmRecords, suggestions,
    // defects ...) - أي مستخدم مفعّل يقدر يقرأ/يكتب. لو احتجتوا
    // تقييد أدق مستقبلاً، ضيفوا match block خاص فوق ده.
    // ==========================================================
    match /{document=**} {
      allow read, write: if isActive();
    }
  }
}
