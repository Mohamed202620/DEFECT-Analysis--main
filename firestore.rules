rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // Helpers
    // ==========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : "";
    }

    function isActive() {
      return isSignedIn() && myProfile().status == "active";
    }

    // ==========================================================
    // users
    // ==========================================================
    match /users/{userId} {

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.status == "pending"
                    && request.resource.data.role == "pending"
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && !request.resource.data.keys().hasAny(["password", "passwordHash", "salt"]);

      allow get: if isSignedIn()
                 && (request.auth.uid == userId || myRole() in ["admin", "manager"]);

      allow list: if (isSignedIn()
                      && (myRole() in ["admin", "manager"]
                          || resource.data.role in ["technician", "engineer"]))
                  || (!isSignedIn() && request.query.limit <= 1);

      allow update: if isSignedIn()
                    && (request.auth.uid == userId || myRole() == "admin");

      allow delete: if myRole() == "admin";
    }

    // ==========================================================
    // tickets - دورة حياة التذكرة
    // pending -> assigned -> resolved -> closed
    //                     resolved -> reopened -> resolved ...
    // ==========================================================
    match /tickets/{ticketId} {

      allow read: if isActive();

      allow create: if isActive()
                    && request.resource.data.status == "pending"
                    && request.resource.data.reportedByUid == request.auth.uid;

      allow update: if isActive() && myRole() in ["manager", "admin"]
                    && resource.data.status == "pending"
                    && request.resource.data.status == "assigned";

      allow update: if isActive()
                    && resource.data.status in ["assigned", "reopened"]
                    && request.resource.data.status == "resolved"
                    && (myRole() == "admin" || resource.data.assignedToUid == request.auth.uid);

      allow update: if isActive()
                    && resource.data.status == "resolved"
                    && request.resource.data.status in ["closed", "reopened"]
                    && (myRole() == "admin" || resource.data.reportedByUid == request.auth.uid);
    }

    // ==========================================================
    // باقي المجموعات (machineErrors, machineErrorLogs, pmRecords,
    // suggestions, defects ...) - أي مستخدم مفعّل يقدر يقرأ/يكتب
    // ==========================================================
    match /{document=**} {
      allow read, write: if isActive();
    }
  }
}
