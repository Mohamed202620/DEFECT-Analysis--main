{
  "name": "maintenance-system",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.mjs",
    "lint": "node --check server.js && node scripts/build.mjs",
    "deploy": "firebase deploy --only hosting:main --project maintenance-defect-system",
    "deploy:dev": "node scripts/deployDev.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:functions": "firebase deploy --only functions",
    "test:rules": "firebase emulators:exec --project demo-defect-rules --only firestore \"node --test tests/rules.test.mjs\"",
    "test": "node tests/run-logic-tests.mjs && node tests/worker-tests.mjs && node tests/integration-upload.mjs && node tests/client-reset.mjs && node tests/dev-firebase-isolation.mjs && node --expose-internals scripts/check-imports.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": ">=1.13.6",
    "@opentelemetry/core": ">=2.8.0",
    "basic-ftp": ">=6.2.1",
    "uuid": ">=11.1.1",
    "ip-address": ">=10.7.4",
    "chokidar": "^4.0.0"
  }
}
